# NutriLens 部署配置（Nginx）
# 用法：复制到 /etc/nginx/sites-available/nutrilens，然后建软链 + 测试 + 重载：
#   sudo ln -sf /etc/nginx/sites-available/nutrilens /etc/nginx/sites-enabled/nutrilens
#   sudo rm -f /etc/nginx/sites-enabled/default      # 禁用默认站点，避免冲突
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /home/ubuntu/nutrilens/frontend/dist;
    index index.html;

    # ---- 前端静态文件（Vue 单页应用）+ SPA 路由回退 ----
    # 刷新子页面（/chat、/history、/profile、/about）不会 404
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---- 后端 API（FastAPI），含 SSE 流式（识别进度、对话逐字）----
    # proxy_buffering off 是关键：关掉缓冲，SSE 才能实时推到浏览器
    location /api/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding on;
    }

    location /docs {
        proxy_pass http://127.0.0.1:8010;
    }
    location /openapi.json {
        proxy_pass http://127.0.0.1:8010;
    }
}

# ===== 域名 + HTTPS（需要时）=====
# 不想绑域名、只用 IP 也完全没问题，保持上面的 80 块即可（HTTP 明文，内部演示足够）。
# 绑域名的话：把 listen 80 default_server 改成 listen 443 ssl; 并补证书配置，
# 或用 certbot 申请证书后填写 ssl_certificate / ssl_certificate_key。
