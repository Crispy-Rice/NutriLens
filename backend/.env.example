# ============================================================
#  NutriLens 后端配置示例
#  复制为 .env 后按需修改：  cp .env.example .env
#  .env 已被 .gitignore 忽略，API Key 只会留在本机。
# ============================================================

# --- 应用 ---
DEBUG=false
# 逗号分隔；Vite 开发服务器默认跑在 5183（见 frontend/vite.config.ts），
# 生产请改成你的前端域名。
CORS_ORIGINS=http://localhost:5183,http://127.0.0.1:5183

# 监听端口。8000/5173 在本机已被其他项目占用，故这里取 8010。
# 改动后需同步修改 frontend/vite.config.ts 的 proxy 目标。
BACKEND_PORT=8010

# --- 图片限制 ---
# 前端会先把最长边压到 1600/q0.8，这里是不信任前端后的硬上限
MAX_UPLOAD_MB=10
MAX_IMAGE_EDGE=1600
JPEG_QUALITY=85

# --- 多图预算 ---
# prefill 开销随图片张数近似线性增长，所以多一张图就降一次单张分辨率。
# 4 张图如果都按 1600px 发，固定开销会从约 2.2 秒涨到 6–8 秒；1024px 大约减半。
MAX_IMAGES=4
MULTI_IMAGE_MAX_EDGE=1024
# 一次请求里所有图片的合计上限，避免 4 张各自顶到 MAX_UPLOAD_MB
MAX_TOTAL_UPLOAD_MB=20

# --- 多轮对话 ---
# 回放给模型的消息条数。第一轮的分析永远保留（它是整段对话的锚点），
# 其余只带最近 N 条，防止 token 随轮次线性膨胀。
MAX_HISTORY_TURNS=8
# 单条用户消息的字数上限
MAX_TURN_TEXT_CHARS=1000

# --- 隐私 ---
# 说明：图片处理全程在内存中完成，服务端不把原图写入磁盘，因此没有
# 临时文件目录和清理周期需要配置。Starlette 自身会把超过约 1MB 的上传
# 暂存到系统临时目录，并在请求结束时自动删除，这一行为由框架保证。
# 详见 README「隐私与数据处理」。

# --- 数据库（只存结构化结果，永不存图） ---
# 留空则使用 backend/.runtime/nutrilens.db
DATABASE_URL=

# --- 大模型（OpenAI 兼容接口） ---
# auto           = 有 KEY 走真实接口，没有则自动降级到内置 Mock
# openai_compat  = 强制真实接口（无 KEY 直接报错）
# mock           = 强制离线 Mock，用于无网络演示与前端联调
LLM_PROVIDER=auto

# 阿里云百炼 DashScope 的 OpenAI 兼容端点。换其他厂商只需改这三项。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-vl-max-latest
LLM_API_KEY=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# --- 推理/思考模式 ---
# 默认关闭以降低首字延迟。
#
# 注意 LLM_THINKING_PARAM 的语义：
#   填参数名  = 每次请求都显式下发该字段的布尔值（false 也会发出去）。
#               这是必须的——不下发等于"用厂商默认值"，而 Qwen3 系列不少型号
#               默认是开启思考的，会导致识别慢一个数量级。
#   留空      = 完全不提这个字段，适合不接受未知参数的厂商。
LLM_ENABLE_THINKING=false
LLM_THINKING_PARAM=enable_thinking

# 要求模型返回严格 JSON（response_format=json_object）。个别模型不支持时置 false，
# 解析器仍然会从自由文本里抽取 JSON。
LLM_JSON_MODE=true

# 请求模型在流式响应末尾附带 token 用量（stream_options.include_usage）。
# token 数是判断"思考模式是否真的关掉了"的关键依据，建议保持开启。
# 若厂商拒绝该参数（报错会提示），置为 false。
LLM_REQUEST_USAGE=true

# --- 识别置信度 ---
# 低于该值时前端固定提示"可能识别不准，请确认或重新拍摄"
LOW_CONFIDENCE_THRESHOLD=0.55
